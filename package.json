{
  "name": "secretary",
  "version": "1.0.0",
  "description": "QQ群消息秘书 - QQ群通知归类总结日报工具",
  "author": "Secretary",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win portable",
    "dist:dir": "electron-vite build && electron-builder --win dir"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue": "^3.5.0"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.secretary.app",
    "productName": "Secretary",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Secretary-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "Secretary-${version}-portable.${ext}",
      "unpackDirName": "Secretary"
    },
    "compression": "maximum"
  }
}